# Public Firebase Web app configuration. These values identify the Firebase
# project; Firestore Security Rules and Firebase Auth enforce access.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public Turnstile widget configuration. The matching secret stays server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Production video creation validates both the action and hostname.
VIDEO_TURNSTILE_HOSTNAMES=math-solver.io,www.math-solver.io

# Server-only Gemini configuration for solutions, practice, and OCR.
# LLM_PROVIDER selects web/mobile solving, practice, OCR, and math review.
# Complex video planning/review has an independent provider; do not route it
# to a smaller solver model without a complete lesson-generation smoke test.
LLM_PROVIDER=gemini
VIDEO_LLM_PROVIDER=gemini
AZURE_LLM_ENDPOINT=
AZURE_LLM_API_KEY=
AZURE_LLM_DEPLOYMENT=gpt-4.1-nano
# Use the complete https://<resource>.services.ai.azure.com/openai/v1/responses URL.
# GPT-5 mini uses low reasoning with an extra 4000-token reasoning allowance.
# Voice transcription QA still requires Gemini; this deployment has no audio input.
GOOGLE_CLOUD_API_KEY=
# Optional override; defaults to gemini-3.1-flash-lite.
GEMINI_MODEL=
# Optional independent reviewer override; otherwise uses GEMINI_MODEL.
GEMINI_REVIEW_MODEL=

# Require a valid X-Firebase-AppCheck token on /api/mobile/v1/*.
# Keep false while registering debug/release providers and monitoring metrics;
# set true before public store distribution.
# Video job creation always requires App Check regardless of this rollout flag.
MOBILE_APP_CHECK_ENFORCED=false

# Server-controlled mobile update policy. Bump LATEST_VERSION to encourage an
# update. A hard minimum also requires MIN_VERSION_REASON=compatibility or
# security plus a valid store URL; marketing changes (including future ads)
# are never a reason to force an update.
MOBILE_IOS_LATEST_VERSION=1.0.0
MOBILE_IOS_MIN_SUPPORTED_VERSION=1.0.0
MOBILE_IOS_MIN_VERSION_REASON=
MOBILE_IOS_STORE_URL=
MOBILE_IOS_UPDATE_MESSAGE=
MOBILE_ANDROID_LATEST_VERSION=1.0.0
MOBILE_ANDROID_MIN_SUPPORTED_VERSION=1.0.0
MOBILE_ANDROID_MIN_VERSION_REASON=
MOBILE_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=io.mathsolver.app
MOBILE_ANDROID_UPDATE_MESSAGE=

# Server-only explanation-video backend. Production uses Cloud Tasks and a
# private Cloud Run renderer; local development can target a local renderer
# with VIDEO_QUEUE_MODE=direct and VIDEO_DIRECT_RENDER_SECRET.
FIREBASE_ADMIN_PROJECT_ID=
VIDEO_STORAGE_BUCKET=
VIDEO_QUEUE_MODE=
VIDEO_QUEUE_PROJECT=
VIDEO_QUEUE_LOCATION=us-central1
VIDEO_QUEUE_NAME=video-render
VIDEO_RENDERER_URL=
VIDEO_TASK_SERVICE_ACCOUNT=
VIDEO_DIRECT_RENDER_SECRET=
# Renderer narration switch: azure or gemini (mock is for offline tests only).
# Save local overrides in ignored .env; changing this alone does not update the
# remote Cloud Run worker used by the web/mobile app. Redeploy that worker.
VIDEO_TTS_PROVIDER=gemini
# Azure OpenAI: full /openai/deployments/<name>/audio/speech?api-version=<version>
# URL, including the deployment name and API version supplied by Azure.
AZURE_TTS_ENDPOINT=
AZURE_TTS_API_KEY=
AZURE_TTS_VOICE=coral
# Gemini settings are retained independently for a one-variable rollback.
VIDEO_TTS_MODEL=gemini-3.1-flash-tts-preview
VIDEO_TTS_VOICE=Sulafat
# Optional shared voice direction; omit to use the patient math tutor default.
# VIDEO_TTS_STYLE=
VIDEO_VOICE_QA=true
VIDEO_TTS_ATTEMPTS=5
VIDEO_TTS_WORKERS=1
# Secret Manager resource names and optional pinned version overrides used by
# deployment scripts. The web and renderer should use separate API keys,
# restricted to the Generative Language API.
WEB_GEMINI_SECRET=mathsolver-web-gemini-api-key
WEB_GEMINI_SECRET_VERSION=
VIDEO_GEMINI_SECRET=mathsolver-gemini-api-key
VIDEO_GEMINI_SECRET_VERSION=
VIDEO_AZURE_TTS_SECRET=mathsolver-azure-tts-api-key
VIDEO_AZURE_TTS_SECRET_VERSION=
WEB_AZURE_LLM_SECRET=mathsolver-web-azure-llm-api-key
WEB_AZURE_LLM_SECRET_VERSION=
VIDEO_AZURE_LLM_SECRET=mathsolver-video-azure-llm-api-key
VIDEO_AZURE_LLM_SECRET_VERSION=
TURNSTILE_SECRET_NAME=mathsolver-turnstile-secret
TURNSTILE_SECRET_VERSION=

# Contact form delivery. TELEGRAM_BOT_TOKEN is used directly only for local
# development. Production deploys mount the bot token from Secret Manager.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_SECRET=mathsolver-telegram-bot-token
TELEGRAM_BOT_SECRET_VERSION=
CONTACT_TURNSTILE_HOSTNAMES=math-solver.io,www.math-solver.io

# Server-only Pressroom key used to render /blog and /blog/[slug].
PRESSROOM_API_KEY=
