# Public Firebase Web app configuration. These values identify the Firebase
# project; Firestore Security Rules and Firebase Auth enforce access.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public Turnstile widget configuration. The matching secret stays server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Production video creation validates both the action and hostname.
VIDEO_TURNSTILE_HOSTNAMES=math-solver.io,www.math-solver.io

# Server-only Gemini configuration for solutions, practice, and OCR.
GOOGLE_CLOUD_API_KEY=
# Optional override; defaults to gemini-3.1-flash-lite.
GEMINI_MODEL=
# Optional independent reviewer override; otherwise uses GEMINI_MODEL.
GEMINI_REVIEW_MODEL=

# Require a valid X-Firebase-AppCheck token on /api/mobile/v1/*.
# Keep false while registering debug/release providers and monitoring metrics;
# set true before public store distribution.
# Video job creation always requires App Check regardless of this rollout flag.
MOBILE_APP_CHECK_ENFORCED=false

# Server-only explanation-video backend. Production uses Cloud Tasks and a
# private Cloud Run renderer; local development can target a local renderer
# with VIDEO_QUEUE_MODE=direct and VIDEO_DIRECT_RENDER_SECRET.
FIREBASE_ADMIN_PROJECT_ID=
VIDEO_STORAGE_BUCKET=
VIDEO_FREE_LIMIT=10
VIDEO_QUEUE_MODE=
VIDEO_QUEUE_PROJECT=
VIDEO_QUEUE_LOCATION=us-central1
VIDEO_QUEUE_NAME=video-render
VIDEO_RENDERER_URL=
VIDEO_TASK_SERVICE_ACCOUNT=
VIDEO_DIRECT_RENDER_SECRET=
# Secret Manager resource names and optional pinned version overrides used by
# deployment scripts. The web and renderer should use separate API keys,
# restricted to the Generative Language API.
WEB_GEMINI_SECRET=mathsolver-web-gemini-api-key
WEB_GEMINI_SECRET_VERSION=
VIDEO_GEMINI_SECRET=mathsolver-gemini-api-key
VIDEO_GEMINI_SECRET_VERSION=
TURNSTILE_SECRET_NAME=mathsolver-turnstile-secret
TURNSTILE_SECRET_VERSION=

# Server-only Pressroom key used to render /blog and /blog/[slug].
PRESSROOM_API_KEY=
